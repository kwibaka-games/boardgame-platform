# Copy to deploy/.env and adjust.

# Browser-visible origin. This must match exactly what users type in the
# address bar, otherwise login/WS origin checks reject the request.
# Direct dev access on the 192.168.1.102 machine:
PUBLIC_ORIGIN=http://192.168.1.102:8080
# HTTPS via the project Caddy container:
# PUBLIC_ORIGIN=https://game.realkawaiibaka.com
# Optional: list multiple exact origins if needed.
# PUBLIC_ORIGINS=https://game.realkawaiibaka.com,https://game.example.com
# COOKIE_SECURE=1

# 0 for HTTP, 1 when serving through HTTPS. Secure cookies are required once
# you use TLS; they will not be sent over plain HTTP.
COOKIE_SECURE=0

# Shared secret between platform and game processes. Change this.
GAME_SECRET=change-me-to-a-long-random-string

# Accounts are created through /api/auth/register. The old DEV_USERS seeding
# is intentionally no longer used.
# The first verified registration becomes admin unless ADMIN_EMAIL is set.
# ADMIN_EMAIL=you@example.com

# SMTP for email verification. If EMAIL_DEBUG=1 and no SMTP is configured,
# the verification code is returned to the browser and logged; never leave
# this on for a public deployment.
EMAIL_DEBUG=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

SESSION_TTL_HOURS=168
